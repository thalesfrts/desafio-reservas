<% provide(:title, "Gestão de Reservas | Admin") %>
<% provide(:page_heading, "Administração de Reservas") %>

<div class="w-full">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-slate-900">Gestão de Reservas</h1>
      <p class="text-sm text-slate-500 mt-1">Aprovação, negação e acompanhamento de todas as áreas comuns.</p>
    </div>
  </div>

  <div class="panel-surface overflow-hidden rounded-2xl">
    <% if @reservations.empty? %>
      <div class="py-12 text-center">
        <p class="text-sm font-medium text-slate-500">Nenhuma reserva registrada no sistema.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-violet-100/80">
          <thead class="bg-violet-50/60">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-violet-700">Morador</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-violet-700">Área</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-violet-700">Período</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider text-violet-700">Status</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-bold uppercase tracking-wider text-violet-700">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-violet-100/80 bg-white/95">
            <% @reservations.each do |res| %>
              <tr class="transition-colors hover:bg-violet-50/60">
                <td class="whitespace-nowrap px-6 py-4">
                  <p class="text-sm font-bold text-slate-900"><%= res.user.name %></p>
                  <p class="text-xs text-slate-500"><%= res.user.email %></p>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm font-bold text-slate-900">
                  <%= res.area.name %>
                </td>
                <td class="px-6 py-4 text-xs text-slate-600">
                  <p><span class="font-semibold text-slate-800">Início:</span> <%= l(res.start_time, format: "%d/%m/%Y %H:%M") %></p>
                  <p><span class="font-semibold text-slate-800">Fim:</span> <%= l(res.end_time, format: "%d/%m/%Y %H:%M") %></p>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% status_colors = { 
                    'requested' => 'bg-amber-100 text-amber-800',
                    'approved' => 'bg-emerald-100 text-emerald-800',
                    'denied' => 'bg-rose-100 text-rose-800',
                    'canceled' => 'bg-slate-100 text-slate-800'
                  } %>
                  <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold leading-5 <%= status_colors[res.status] %>">
                    <%= I18n.t("activerecord.attributes.reservation.statuses.#{res.status}", default: res.status.titleize) %>
                  </span>
                  <% if res.denied? && res.denial_reason.present? %>
                    <p class="mt-1 text-xs text-rose-600 max-w-xs truncate" title="<%= res.denial_reason %>">
                      Motivo: <%= res.denial_reason %>
                    </p>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right text-sm font-medium">
                  
                  <div class="flex flex-col items-end gap-2">
                    <% if res.requested? %>
                      <div class="flex gap-2">
                        <%= button_to "Aprovar", approve_admin_reservation_path(res), method: :patch, class: "rounded bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-700 hover:bg-emerald-200 transition-colors" %>
                      </div>
                      <%= form_with url: deny_admin_reservation_path(res), method: :patch, local: true, class: "flex items-center gap-1 mt-1" do |f| %>
                        <%= f.text_field :denial_reason, placeholder: "Motivo da negação...", required: true, class: "w-32 rounded border border-gray-300 px-2 py-1 text-xs focus:border-rose-500 focus:ring-rose-200" %>
                        <%= f.submit "Negar", class: "rounded bg-rose-100 px-3 py-1 text-xs font-bold text-rose-700 hover:bg-rose-200 transition-colors cursor-pointer" %>
                      <% end %>
                    <% end %>

                    <% if res.cancellable? %>
                      <%= button_to "Cancelar Reserva", admin_reservation_path(res), method: :delete, data: { turbo_confirm: "Tem certeza que deseja cancelar esta reserva?" }, class: "font-semibold text-rose-600 hover:text-rose-800" %>
                    <% end %>

                    <% if !res.requested? && !res.cancellable? %>
                      <span class="text-slate-400">---</span>
                    <% end %>
                  </div>

                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>